# Dedicated inbox + GCP (never commit real values)
GOOGLE_CLOUD_PROJECT=olympus-vat-agent
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Mailbox to watch. On Cloud Run, ADC uses the runtime SA; GMAIL_ADDRESS
# impersonates that user when domain-wide delegation is enabled (Workspace).
GMAIL_ADDRESS=
GMAIL_PUBSUB_TOPIC=projects/olympus-vat-agent/topics/gmail-vat

INGEST_TOKEN=change-me
PUBSUB_FALLBACK_POLL=false

HARNESS_CONFIDENCE_THRESHOLD=0.75
HARNESS_MATH_TOLERANCE_VND=1
SHEETS_SPREADSHEET_ID=
SHEETS_POSTED_TAB=Posted
GMAIL_OPERATOR=

